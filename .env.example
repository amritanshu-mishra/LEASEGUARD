# --- LeaseGuard configuration ---
# Groq is used for extraction (not Anthropic).
GROQ_API_KEY=
EXTRACTION_MODEL=llama-3.3-70b-versatile

# Use deterministic rules instead of a model call. Keep this on for the hackathon demo
# so the demo is reproducible and never depends on network/rate limits.
USE_FIXTURES=true

# Storage
DB_PATH=backend/leaseguard.db
UPLOAD_DIR=backend/uploads

# Limits / CORS
MAX_UPLOAD_MB=10
MAX_PAGES=50
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
